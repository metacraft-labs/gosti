{
  "product": "gosti",
  "versionFile": "vm_harness.nimble",
  "packageName": "metacraft-gosti",
  "commands": [
    "gosti",
    "vm-harness"
  ],
  "license": "Apache-2.0",
  "summary": "Cross-platform VM lifecycle orchestration",
  "targets": [
    {
      "id": "linux-x86_64",
      "runner": "eph-linux-x64-release",
      "assets": [
        "{product}-{version}-linux-x86_64.tar.gz",
        "{product}-{version}-linux-x86_64.json",
        "metacraft-gosti_{version}-1_amd64.deb",
        "metacraft-gosti-{version}-1.x86_64.rpm"
      ],
      "hostedRunner": "ubuntu-24.04",
      "runnerMigration": {
        "version": "0.1.1",
        "owner": "zah",
        "followup": "https://github.com/metacraft-labs/metacraft-specs/blob/latest/issues/2026-09-24-ci-runner-mode-policy-conflicts-with-hosted-runner-ban.md"
      }
    },
    {
      "id": "darwin-aarch64",
      "runner": [
        "self-hosted",
        "macos",
        "arm64"
      ],
      "assets": [
        "{product}-{version}-darwin-aarch64.tar.gz",
        "{product}-{version}-darwin-aarch64.json"
      ],
      "hostedRunner": "macos-26",
      "runnerMigration": {
        "version": "0.1.1",
        "owner": "zah",
        "followup": "https://github.com/metacraft-labs/metacraft-specs/blob/latest/issues/2026-09-24-ci-runner-mode-policy-conflicts-with-hosted-runner-ban.md"
      }
    },
    {
      "id": "windows-x86_64",
      "runner": [
        "self-hosted",
        "windows",
        "x64"
      ],
      "hostedRunner": "windows-2025",
      "runnerMigration": {
        "version": "0.1.1",
        "owner": "zah",
        "followup": "https://github.com/metacraft-labs/metacraft-specs/blob/latest/issues/2026-09-24-ci-runner-mode-policy-conflicts-with-hosted-runner-ban.md"
      },
      "assets": [
        "{product}-{version}-windows-x86_64.zip",
        "{product}-{version}-windows-x86_64.json"
      ]
    },
    {
      "id": "windows-aarch64",
      "runner": "windows-11-arm",
      "assets": [
        "{product}-{version}-windows-aarch64.zip",
        "{product}-{version}-windows-aarch64.json"
      ],
      "runnerReason": "Temporary native Windows ARM64 release migration while the two-slot fleet queue is pending.",
      "runnerMigration": {
        "version": "0.1.1",
        "owner": "zah",
        "followup": "https://github.com/metacraft-labs/metacraft-specs/blob/latest/issues/2026-09-29-windows-arm64-release-runner-migration.md"
      }
    }
  ],
  "runtimeSources": {
    "pcre": {
      "url": "https://ftp.exim.org/pub/pcre/pcre-8.45.tar.bz2",
      "sha256": "4dae6fdcd2bb0bb6c37b5f97c33c2be954da743985369cddac3546e3218bffb8"
    }
  },
  "versionChecks": [
    {
      "file": "src/vm_harness/backends/qemu_windows_arm.nim",
      "pattern": "QwaVmHarnessVersion\\*\\s*=\\s*\"([^\"]+)\""
    }
  ],
  "unsignedReleaseVersion": "0.1.1"
}
