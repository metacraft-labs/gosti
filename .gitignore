# Build artifacts
build/
nimcache/
/.repro/
/result
*.exe
*.dylib
*.so

# Direnv cache
.direnv/
.envrc.cache
.pre-commit-config.yaml

# Test scratch
test-logs/
tests/**/*.tmp
tests/**/nimcache/

# D4 / W4 diagnostic serial logs + per-run scratch directories that land
# at repo root during local iteration.
/_d4-coldinit-diag.log
/_d4-fix*-serial/
/_d4-fix*-diag-serial/
/_d4_run_*.log
/_w4_diag/
/x1-e2e-test*.log
/x1-review-rerun.log
/x1-serial-logs*/

# Compiled Nim test binaries. `nim c tests/unit/t_foo.nim` writes its executable
# beside the source, as `tests/unit/t_foo`. Every real asset under tests/ carries
# an extension; the compiled output is the only thing that does not.
tests/**/t_*
!tests/**/t_*/
!tests/**/t_*.*
# ...then re-ignore the Windows spellings, which DO carry an extension and would
# otherwise be resurrected by the re-include above (cf. `*.exe` near the top).
tests/**/t_*.exe
tests/**/t_*.pdb
